<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>UniLink</AssemblyName>
    <RootNamespace>UniLink.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>UniLink</AssemblyTitle>
    <Description>University Wi-Fi sign-in and session keeper</Description>
    <Product>UniLink</Product>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../UniLink.Core/UniLink.Core.csproj" /></ItemGroup>
</Project>
